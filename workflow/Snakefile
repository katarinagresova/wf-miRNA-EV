from pathlib import Path

import pandas as pd
from snakemake.exceptions import WorkflowError
from snakemake.utils import validate

WF_VERSION = "0.1.0.dev0"

configfile: "config/config.yaml"

validate(config, "schemas/config.schema.yaml")
# The read length bins of step 5 (mirna.min_len to mirna.max_len, to 50, 51+) must hold every kept read
_lens = (config["mirna"]["min_len"], config["trim"]["min_len"], config["mirna"]["max_len"])
if not _lens[0] <= _lens[1] <= _lens[2] < 50:
    raise WorkflowError(f"The config needs mirna.min_len <= trim.min_len <= mirna.max_len < 50, the values are {_lens}")

SAMPLES = pd.read_csv(config["samples"], sep="\t", dtype=str).set_index("sample", drop=False)
validate(SAMPLES, "schemas/samples.schema.yaml")
if not SAMPLES.index.is_unique:
    raise WorkflowError(f"Duplicate sample names: {', '.join(SAMPLES.index[SAMPLES.index.duplicated()])}")
# Columns copied into the summary tables
METADATA = [c for c in SAMPLES.columns if c not in ("sample", "fastq")]

_missing = [s for s, fq in SAMPLES["fastq"].items() if not Path(fq).exists()]
if _missing:
    raise WorkflowError(f"FASTQ missing for {len(_missing)} sample(s): {', '.join(_missing)}")

wildcard_constraints:
    sample="|".join(SAMPLES.index),


# Steps 1-8: qc, trim, collapse, refs, classify (read classification, contaminants, miRNA counts), mirna (counter
# tables, summary, off-target check), rrna (rRNA fragment tables), report (QC report)
include: "rules/common.smk"
include: "rules/qc.smk"
include: "rules/trim.smk"
include: "rules/collapse.smk"
include: "rules/refs.smk"
include: "rules/classify.smk"
include: "rules/mirna.smk"
include: "rules/rrna.smk"
include: "rules/report.smk"

# The outputs of the workflow, except results/wf_version.txt
OUTPUTS = [
    "results/library_summary.tsv",
    "results/report/multiqc_report.html",
    "results/qc/raw_reads.tsv",
    "results/trim/summary.tsv",
    "results/collapse/summary.tsv",
    "results/collapse/top_sequences.tsv",
    expand("results/collapse/{sample}/collapsed.fa.gz", sample=SAMPLES.index),
    CLASSIFY_SUMMARY.values(),
    MIRNA_SUMMARY.values(),
    expand("results/rrna/{sample}/fragments.tsv.gz", sample=SAMPLES.index),
]


rule all:
    input:
        OUTPUTS,
        "results/wf_version.txt",


rule wf_version:
    localrule: True
    input:
        counter="results/mirna/bowtie_version.txt",
        # A run that changes an output also writes this file again, with the commit of that run
        outputs=OUTPUTS,
    output:
        "results/wf_version.txt",
    params:
        version=WF_VERSION,
        commit=git_commit(),
        counter="bowtie",
    log:
        "logs/wf_version.log",
    # Only printf and cat; any environment
    conda:
        "envs/align.yaml"
    shell:
        """
        (
        printf 'workflow\\twf-miRNA-EV\\nversion\\t{params.version}\\ncommit\\t{params.commit}\\n'
        printf 'mirna_counter\\t{params.counter}\\nmirna_counter_version\\t%s\\n' "$(cat {input.counter})"
        ) > {output} 2> {log}
        """
